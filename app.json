{
  "expo": {
    "name": "Cave à Vin",
    "slug": "cave-a-vin",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caveavin",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lef69.caveavin",
      "infoPlist": {
        "NSCameraUsageDescription": "CAVOU utilise la caméra pour photographier les étiquettes de vos bouteilles.",
        "NSPhotoLibraryUsageDescription": "CAVOU accède à votre galerie pour importer des photos d'étiquettes.",
        "NSPhotoLibraryAddUsageDescription": "CAVOU peut enregistrer des photos de vos bouteilles dans votre galerie."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0810"
      },
      "package": "com.lef69.caveavin",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-camera",
        {
          "cameraPermission": "CAVOU utilise la caméra pour photographier les étiquettes de vos bouteilles de vin."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://flavien-walk.github.io/cave-a-vin/privacy.html",
      "eas": {
        "projectId": "4af28938-6c6c-4a6b-b661-3ea9d944bf29"
      }
    },
    "owner": "flavien_leo"
  }
}
